DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
CORS_ORIGIN="http://localhost:3000"
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"
# Local administration only. Never expose or commit this key.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
# Supabase Auth UID that exclusively owns the public portfolio CV.
PORTFOLIO_OWNER_ID="YOUR_SUPABASE_USER_ID"
ADMIN_EMAILS="you@example.com"
# Frontend route that saves the last-known-good public snapshot and invalidates Next cache.
FRONTEND_REVALIDATE_URL="https://YOUR_FRONTEND_DOMAIN/api/internal/revalidate-resume"
# Must match frontend RESUME_REVALIDATE_SECRET. Never expose this value.
RESUME_REVALIDATE_SECRET="GENERATE_A_LONG_RANDOM_SECRET"
# Private PDF attachments submitted through the public contact form. This bucket
# must be private; the service-role key remains backend-only.
CONTACT_ATTACHMENT_BUCKET="contact-attachments"
# Resend notification configuration. CONTACT_FROM_EMAIL must use a verified domain.
RESEND_API_KEY="re_YOUR_RESEND_API_KEY"
CONTACT_FROM_EMAIL="Portfolio <contact@example.com>"
CONTACT_OWNER_EMAIL="you@example.com"
