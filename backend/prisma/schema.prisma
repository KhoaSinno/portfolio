generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum ResumeStatus {
  DRAFT
  PUBLISHED
}

enum ContactTopic {
  HIRING
  COLLABORATION
  GENERAL
}

enum ContactStatus {
  NEW
  REVIEWED
  FOLLOW_UP
  ARCHIVED
}

enum ContactNotificationStatus {
  PENDING
  SENT
  FAILED
}

model Resume {
  id           String          @id @default(cuid())
  ownerId      String?
  title        String          @default("Main Resume")
  slug         String?         @unique
  isPrimary    Boolean         @default(false)
  viewsCount   Int             @default(0)
  lastViewedAt DateTime?
  content      Json
  template     String          @default("technical")
  status       ResumeStatus    @default(DRAFT)
  publishedAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  versions     ResumeVersion[]
}

model ResumeVersion {
  id        String   @id @default(cuid())
  resumeId  String
  version   Int
  content   Json
  template  String
  createdAt DateTime @default(now())
  resume    Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@unique([resumeId, version])
}

model PublicResumeSnapshot {
  key             String    @id
  resumeId        String    @unique
  content         Json
  sourceUpdatedAt DateTime?
  savedAt         DateTime  @updatedAt

  @@map("public_resume_snapshots")
}

model ContactMessage {
  id                 String                    @id @default(cuid())
  topic              ContactTopic              @default(GENERAL)
  email              String
  jdLink             String?
  fileName           String?
  attachmentPath     String?                   @unique
  attachmentMimeType String?
  fileSize           Int?
  message            String
  ip                 String?
  status             ContactStatus             @default(NEW)
  internalNote       String?
  notificationStatus ContactNotificationStatus @default(PENDING)
  notificationError  String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  reviewedAt         DateTime?
  archivedAt         DateTime?
}
